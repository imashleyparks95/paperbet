# Pass these through your hosting provider's secret manager. Node does not load this file automatically.
DATA_PROVIDER=espn
# Optional alternative only; ESPN public feeds need no key.
ODDS_API_KEY=
SESSION_SECRET=
ADMIN_TOKEN=
ODDS_REGIONS=us
PORT=3000
NODE_ENV=production
DATABASE_PATH=/data/paperbet.sqlite
SETTLEMENT_INTERVAL_MS=300000
